<form method="post" action="{{ path('app_event_delete', {'id': event.id}) }}" 
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
    <button type="submit" 
        class="w-full rounded-md bg-red-600 px-4 py-2 mt-2 font-semibold text-white shadow hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-400 focus:ring-offset-2 focus:ring-offset-slate-950">
        Supprimer
    </button>
</form>