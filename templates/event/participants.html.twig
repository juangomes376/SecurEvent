{% extends 'base.html.twig' %}

{% block title %}Participants de l'Événement{% endblock %}

{% block body %}
<h1>Participants de l'Événement: {{ event.titre }}</h1>

<table class="table-auto w-full mt-4">
    <thead>
        <tr>
            <th class="text-center px-4 py-2">Prenom</th>
            <th class="text-center px-4 py-2">Nom</th>
            <th class="text-center px-4 py-2">Email</th>
        </tr>
    </thead>
    <tbody>
        {% for participant in participants %}
            <tr class="bg-slate-900/40 border border-slate-800/70 rounded-lg mb-2">
                <td class="text-center px-4 py-2">{{ participant.prenom }}</td>
                <td class="text-center px-4 py-2">{{ participant.nom }}</td>
                <td class="text-center px-4 py-2">{{ participant.email }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="px-4 py-2 text-center text-slate-400">Aucun participant pour cet événement.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% endblock %}