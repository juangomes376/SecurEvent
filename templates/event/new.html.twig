{% extends 'base.html.twig' %}

{% block title %}Nouvel Événement{% endblock %}

{% block body %}
<main class="min-h-screen bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100 flex flex-col items-center justify-start py-20 px-6">

    <div class="w-full max-w-3xl bg-slate-900/40 border border-slate-800/70 rounded-2xl p-10 shadow-md">
        <h1 class="text-3xl font-extrabold text-white mb-6">Créer un nouvel événement</h1>

        {{ include('event/_form.html.twig', {'button_label': 'Créer'}) }}

        <a href="{{ path('app_event_index') }}" class="mt-6 inline-block rounded-md bg-slate-800/60 px-6 py-3 text-slate-200 font-semibold hover:bg-slate-700">
            Retour à la liste
        </a>
    </div>

</main>
{% endblock %}