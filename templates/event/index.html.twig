{% extends 'base.html.twig' %}

{% block title %}Event index{% endblock %}

{% block body %}
    <h1>Event index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Description</th>
                <th>DateDebut</th>
                <th>Lieu</th>
                <th>CapaciteMax</th>
                {% if is_granted('ROLE_USER') %}
                    <th>Reservation</th>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <th>Actions</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
        {% for event in events %}
            <tr>
                <td>{{ event.id }}</td>
                <td><a href="{{ path('app_event_show', {'id': event.id}) }}">{{ event.titre }}</a></td>
                <td>{{ event.description }}</td>
                <td>{{ event.dateDebut ? event.dateDebut|date('Y-m-d') : '' }}</td>
                <td>{{ event.lieu }}</td>
                <td>{{ event.capaciteMax }}</td>
                {% if is_granted('ROLE_USER') %}
                    {# {% if event is not reserved by the current user %} #}
                    <td><form action="{{ path('app_reservation', {'id': event.id}) }}" method="post">
                        <input type="hidden" name="_method" value="PUT">
                        <button type="submit">Reserve</button>
                    </form></td>
                    {# {% else %}
                        <td>Already reserved</td>
                    {% endif %} #}
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <td>
                        <a href="{{ path('app_event_show', {'id': event.id}) }}">show</a>
                        <a href="{{ path('app_event_edit', {'id': event.id}) }}">edit</a>
                    </td>
                {% endif %}

            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_event_new') }}">Create new</a>
    {% endif %}
{% endblock %}
