{% extends 'base.html.twig' %}

{% block title %}Liste des événements{% endblock %}

{% block body %}
<main class="min-h-screen bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100 py-20 px-6">

    <h1 class="text-3xl font-extrabold text-white max-w-6xl mx-auto mb-10">Événements</h1>

    <div class="max-w-6xl mx-auto grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for event in events %}
            <article class="rounded-2xl border border-slate-800/70 bg-slate-900/40 p-6 shadow-sm transition hover:-translate-y-1 hover:bg-slate-900/60">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-semibold text-white">{{ event.titre }}</h3>
                        <p class="mt-1 text-sm text-slate-200">{{ event.description|length > 80 ? event.description[:80] ~ '…' : event.description }}</p>
                        <p class="mt-2 text-xs text-slate-400">Lieu : {{ event.lieu }}</p>
                        <p class="text-xs text-slate-400">Capacité : {{ event.capaciteMax }}</p>
                        <p class="text-xs text-slate-400">Date : {{ event.dateDebut ? event.dateDebut|date('d/m/Y') : 'N/A' }}</p>
                    </div>
                </div>

                {% if is_granted('ROLE_USER') %}
                    <form action="{{ path('app_reservation', {'id': event.id}) }}" method="post" class="mt-4">
                        <input type="hidden" name="_method" value="PUT">
                        <button type="submit" class="w-full rounded-md bg-cyan-400 px-4 py-2 mt-2 font-semibold text-slate-950 shadow hover:bg-cyan-300 focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2 focus:ring-offset-slate-950">
                            Réserver
                        </button>
                    </form>
                {% endif %}

                {% if is_granted('ROLE_USER') %}
                    <div class="mt-4 flex gap-2">
                        <a href="{{ path('app_event_show', {'id': event.id}) }}" class="rounded-md bg-slate-800/60 px-3 py-1 text-xs text-slate-200 hover:bg-slate-700">Voir</a>
                        <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="rounded-md bg-cyan-400 px-3 py-1 text-xs text-slate-950 hover:bg-cyan-300">Modifier</a>
                    </div>
                {% endif %}
            </article>
        {% else %}
            <div class="col-span-full text-center text-slate-200 py-10 border border-slate-800/70 rounded-2xl bg-slate-900/40">
                Aucun événement trouvé.
            </div>
        {% endfor %}
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        <div class="max-w-6xl mx-auto mt-10">
            <a href="{{ path('app_event_new') }}" class="inline-block rounded-md bg-cyan-400 px-6 py-3 text-slate-950 font-semibold shadow hover:bg-cyan-300">
                Créer un nouvel événement
            </a>
        </div>
    {% endif %}

</main>
{% endblock %}