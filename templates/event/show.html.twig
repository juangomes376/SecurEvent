{% extends 'base.html.twig' %}

{% block title %}Event{% endblock %}

{% block body %}

<main class="min-h-screen bg-slate-950 text-slate-100 py-12 px-6">
    <div class="max-w-5xl mx-auto">
        {# Breadcrumb / Retour #}
        <a href="{{ path('app_event_index') }}" class="inline-flex items-center gap-2 mb-8 text-sm text-slate-400 hover:text-cyan-400 transition-colors">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            Retour aux événements
        </a>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            {# Colonne Principale (Gauche) #}
            <div class="lg:col-span-2 space-y-8">
                <div>
                    <h1 class="text-4xl font-extrabold text-white tracking-tight mb-4 break-words">{{ event.titre }}</h1>
                    <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-800/80 px-3 py-1 text-xs font-semibold text-slate-300 truncate max-w-full">
                            <svg class="h-3.5 w-3.5 shrink-0 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                            </svg>
                            <span class="truncate">{{ event.lieu }}</span>
                        </span>
                        <span class="whitespace-nowrap">Créé le {{ event.dateDebut|date('d/m/Y') }}</span>
                    </div>
                </div>

                <div class="prose prose-invert max-w-none text-slate-300">
                    <h3 class="text-xl font-bold text-white mb-4">À propos de cet événement</h3>
                    <p class="leading-relaxed whitespace-pre-wrap break-words">{{ event.description }}</p>
                </div>

                <div class="pt-8">
                    <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                        <svg class="h-6 w-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                        </svg>
                        Localisation
                    </h3>
                    <div class="w-full h-80 rounded-2xl overflow-hidden border border-slate-800/70 shadow-lg bg-slate-900 relative">
                        <!-- Pseudo-élément optionnel pour créer une légère teinte "cyan" par dessus la carte -->
                        <div class="absolute inset-0 bg-cyan-900/10 pointer-events-none z-10" aria-hidden="true"></div>
                        <iframe 
                            width="100%" 
                            height="100%" 
                            frameborder="0" 
                            style="border:0;"
                            allowfullscreen="" 
                            loading="lazy"
                            class="grayscale-[10%] invert-[100%] hue-rotate-180 brightness-95 contrast-125"
                            src="https://maps.google.com/maps?q={{ event.lieu|url_encode }}&t=&z=14&ie=UTF8&iwloc=&output=embed">
                        </iframe>
                    </div>
                </div>
            </div>

            {# Colonne Latérale (Droite) - Panneau de réservation #}
            <div class="lg:col-span-1">
                <div class="sticky top-24 rounded-2xl border border-slate-800/70 bg-slate-900/40 p-6 shadow-xl backdrop-blur-sm">
                    <h3 class="text-lg font-bold text-white mb-6">Détails pratiques</h3>
                    
                    <ul class="space-y-6 mb-8">
                        <li class="flex items-start gap-4">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-400">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-slate-200">Date</p>
                                <p class="text-sm text-slate-400 mt-1">{{ event.dateDebut ? event.dateDebut|date('d/m/Y') : 'Non définie' }}</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-400">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-slate-200">Lieu</p>
                                <p class="text-sm text-slate-400 mt-1 break-words leading-snug">{{ event.lieu }}</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-400">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-slate-200">Disponibilité</p>
                                <p class="text-sm text-slate-400 mt-1">{{ event.placesRestantes }} places / <span class="text-slate-500">{{ event.capaciteMax }} max</span></p>
                            </div>
                        </li>
                    </ul>

                    <div class="pt-6 border-t border-slate-800/60">
                        {% if is_granted('ROLE_USER') %}
                            <form action="{{ path('app_reservation', {'id': event.id}) }}" method="post">
                                <input type="hidden" name="_method" value="PUT">
                                {% if event.reserved ?? false %}
                                    <button type="button" class="w-full relative flex items-center justify-center gap-2 rounded-lg bg-slate-800 px-6 py-3.5 text-sm font-bold text-slate-400 shadow-sm cursor-not-allowed border border-slate-700/50" disabled>
                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                        </svg>
                                        Déjà réservé
                                    </button>
                                {% else %}
                                    <button type="submit" class="w-full relative flex items-center justify-center rounded-lg bg-cyan-400 px-6 py-3.5 text-sm font-bold text-slate-950 shadow-sm hover:bg-cyan-300 focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2 focus:ring-offset-slate-950 transition-all hover:scale-[1.02]">
                                        Réserver ma place
                                    </button>
                                {% endif %}
                            </form>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="flex items-center justify-center w-full rounded-lg border border-slate-700 bg-slate-800/50 px-6 py-3.5 text-sm font-bold text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
                                Se connecter pour réserver
                            </a>
                        {% endif %}
                    </div>

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="mt-6 pt-6 border-t border-slate-800/60">
                            <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4">Administration</h4>
                            <div class="flex gap-2">
                                <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="flex-1 inline-flex justify-center items-center gap-2 rounded-lg bg-slate-800 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700 transition-colors border border-slate-700" title="Modifier">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                                    </svg>
                                </a>
                                <div class="flex-none">
                                    {{ include('event/_delete_form.html.twig') }}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}