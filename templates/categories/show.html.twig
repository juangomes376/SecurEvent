{% extends 'base.html.twig' %}

{% block title %}Catégorie : {{ category.Nom }} · SecureVent{% endblock %}

{% block body %}
<main class="min-h-screen bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100 flex items-center justify-center py-20 px-6">
    <div class="absolute inset-0 bg-gradient-to-b from-cyan-400/5 via-transparent to-transparent blur-3xl pointer-events-none"></div>
    
    <div class="relative w-full max-w-2xl">
        <div class="mb-8">
            <a href="{{ path('app_categories_index') }}" class="text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-2">
                ← Retour à la liste
            </a>
        </div>

        <article class="rounded-3xl border border-slate-800/70 bg-slate-900/60 p-8 lg:p-12 shadow-2xl backdrop-blur-sm">
            <div class="flex items-center justify-between mb-8">
                <span class="rounded-full bg-cyan-500/10 px-4 py-1.5 text-xs font-mono font-bold text-cyan-400 tracking-wider">
                    ID: #{{ category.id }}
                </span>
                <div class="flex gap-3">
                    <a href="{{ path('app_categories_edit', {'id': category.id}) }}" class="rounded-xl border border-slate-700 bg-slate-800/50 px-5 py-2 text-sm font-semibold text-white hover:bg-slate-800 transition-colors">
                        Modifier
                    </a>
                </div>
            </div>

            <h1 class="text-4xl font-extrabold tracking-tight text-white mb-6">
                {{ category.Nom }}
            </h1>

            <div class="mt-12 pt-8 border-t border-slate-800/50 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
                <p class="text-sm text-slate-400 italic">
                    Cette catégorie définit une thématique pour vos événements.
                </p>
                
                {{ include('categories/_delete_form.html.twig') }}
            </div>
        </article>
    </div>
</main>
{% endblock %}
