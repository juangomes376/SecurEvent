{% extends 'base.html.twig' %}

{% block title %}Catégories · SecureVent{% endblock %}

{% block body %}
<main class="min-h-screen bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100">
    <header class="relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-cyan-400/10 via-transparent to-transparent blur-3xl"></div>
        <div class="relative max-w-6xl mx-auto px-6 py-12 lg:py-16">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                <div>
                    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-white">
                        Toutes les <span class="text-cyan-400">catégories</span>
                    </h1>
                    <p class="mt-2 text-slate-400">Gérez les thématiques d'événements de cybersécurité.</p>
                </div>
                <div>
                    <a href="{{ path('app_categories_new') }}" class="inline-flex items-center justify-center rounded-md bg-cyan-400 px-6 py-2.5 text-sm font-semibold text-slate-950 shadow hover:bg-cyan-300 transition-colors">
                        + Nouvelle catégorie
                    </a>
                </div>
            </div>
        </div>
    </header>

    <section class="max-w-6xl mx-auto px-6 pb-20">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for category in categories %}
                <article class="group relative rounded-2xl border border-slate-800/70 bg-slate-900/40 p-6 shadow-sm transition-all hover:border-cyan-400/30 hover:bg-slate-900/60">
                    <div class="flex items-center justify-between mb-4">
                        <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-400 group-hover:bg-cyan-500/20 transition-colors">
                            <span class="text-lg font-bold">#</span>
                        </div>
                        <span class="text-xs font-mono text-slate-500">ID: {{ category.id }}</span>
                    </div>
                    <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">{{ category.Nom }}</h3>
                    
                    <div class="mt-8 flex items-center gap-3">
                        <a href="{{ path('app_categories_show', {'id': category.id}) }}" class="flex-1 text-center rounded-lg bg-slate-800/60 px-4 py-2 text-xs font-semibold text-slate-200 hover:bg-slate-800 transition-colors">
                            Détails
                        </a>
                        <a href="{{ path('app_categories_edit', {'id': category.id}) }}" class="flex-1 text-center rounded-lg border border-slate-700 px-4 py-2 text-xs font-semibold text-slate-200 hover:bg-slate-900 transition-colors">
                            Modifier
                        </a>
                    </div>
                </article>
            {% else %}
                <div class="col-span-full rounded-2xl border border-dashed border-slate-700/60 bg-slate-900/40 p-12 text-center">
                    <p class="text-slate-400">Aucune catégorie trouvée. Commencez par en créer une.</p>
                </div>
            {% endfor %}
        </div>
    </section>
</main>
{% endblock %}
